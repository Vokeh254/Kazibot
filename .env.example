# ─────────────────────────────────────────────────────────────────────────────
# KaziBot — required environment variables
# Copy this file to .env and fill in real values before running the application.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Database URL
# SQLite (local/dev):   sqlite+aiosqlite:///./kazibot.db
# PostgreSQL (prod):    postgresql+asyncpg://user:password@host:5432/kazibot
DATABASE_URL=sqlite+aiosqlite:///./kazibot.db

# LLM provider to use for cover letter generation: "openai" or "anthropic"
LLM_PROVIDER=openai

# Fernet symmetric encryption key used to encrypt OAuth2 tokens and API keys at rest.
# Generate a new key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Google OAuth2 credentials — create a project in Google Cloud Console,
# enable the Gmail API, and create OAuth2 credentials (Web application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Custom User-Agent string sent by the scraper.
# Leaving this blank falls back to the default value defined in config.py.
CUSTOM_USER_AGENT=
